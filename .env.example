# ===========================================================================
# Smart Import — configuracion unica para local y produccion.
#
#   cp .env.example .env      y edita lo que necesites
#
# El pipeline es determinístico: reglas + librerias, sin modelo.
# Cada capacidad opcional se apaga con su flag sin tocar nada mas.
# ===========================================================================

# --------------------------------------------------------------- que corre
# El nucleo (normalize + extraccion determinística) SIEMPRE esta. Estas son opcionales:
SMART_IMPORT_GEOCODING_ENABLED=true

# Imagen Docker (build target, no un modo de runtime):
#   runtime              ~370 MB  — sin libpostal
#   runtime-libpostal    +~2 GB   — enhancer on-demand (recomendado en prod)
SMART_IMPORT_TARGET=runtime-libpostal

# --------------------------------------------- extraccion (reglas, sin modelo)
# Region ISO por defecto para telefonos (AR, BR, US, IN...). El job puede pisarla.
SMART_IMPORT_DEFAULT_PHONE_REGION=AR

# A partir de que score una linea del paste se convierte en PARADA.
# MEDIDO (100 entregas reales vs 18 lineas de saludo/encabezado): el ruido tope
# 0,05 y la mediana de las entregas 0,83 — dos poblaciones separadas por un
# abismo. Cualquier valor entre 0,20 y 0,55 da el MISMO resultado; se queda en
# el borde alto porque desde 0,60 empieza a costar entregas reales sin frenar
# nada nuevo.
SMART_IMPORT_DELIVERY_ACCEPT_THRESHOLD=0.55
# Entre review y accept: probable entrega, la mira un humano. En el corpus
# medido esta banda queda vacia: es red de contencion, no un caso frecuente.
SMART_IMPORT_DELIVERY_REVIEW_THRESHOLD=0.30

# Por debajo de esto una direccion no se acepta NI se manda al geocoder.
# MEDIDO sobre 3321 direcciones con ground truth, estratificado:
#
#   estrato                           n    %>=0.50  %>=0.75  %>=0.86
#   con altura                      958      100      100       99
#   calle sin altura (una cuadra)  2363       21       17        0
#   nombre + numero (falso pos.)     10      100      100        0
#
# SUBIRLO NO SIRVE: de 0,50 a 0,75 no cambia nada, y el unico valor que mata
# los falsos positivos ('Juan Perez 5' = 0,85) es 0,86, que se lleva el 100% de
# las direcciones a nivel calle, legitimas. Las dos poblaciones son iguales:
# 'Lola Mora 421' es una calle real y saca 0,70. Separarlas pide un lexicon de
# nombres de pila, no un umbral.
SMART_IMPORT_ADDRESS_ACCEPT_THRESHOLD=0.50
# Sin medir (falta ground truth). Defaults del codigo; equivocarse cuesta poco.
SMART_IMPORT_NAME_ACCEPT_THRESHOLD=0.50
SMART_IMPORT_PHONE_ACCEPT_THRESHOLD=0.60

# Cuanta evidencia estructural necesita un .txt para tratarse como TABLA en vez
# de como paste. Un paste de WhatsApp no es un CSV porque tenga comas: leido
# como tabla, cada linea se parte en columnas inventadas. Sin medir.
SMART_IMPORT_TEXT_MIN_CONSISTENCY=0.80
SMART_IMPORT_TEXT_MIN_LINES=3
SMART_IMPORT_TEXT_MAX_PROSE_RATIO=0.20
SMART_IMPORT_TEXT_MIN_HEADER_SCORE=0.50

# --------------------------------------------------- parser de direcciones
# El heuristico SIEMPRE corre. libpostal es enhancer on-demand: solo se consulta
# cuando el gate detecta road faltante o sospechosa (parcela, manzana, India…).
# Requiere imagen `runtime-libpostal`. Ver docs/libpostal.md.
SMART_IMPORT_LIBPOSTAL_ENABLED=true
# Solo para benchmarks (`benchmark-extraction`): heuristic | libpostal | enhanced
# SMART_IMPORT_ADDRESS_PARSER=heuristic
#
# Lexicons (JSON en smart_import/resources/). Override opcional:
# SMART_IMPORT_RESOURCES_DIR=/path/to/dir   # reemplaza todos los *.json por nombre
# SMART_IMPORT_LABELS_PATH=...
# SMART_IMPORT_GEO_KEYWORDS_PATH=...
# SMART_IMPORT_OVERRIDES_PATH=...            # vepathos_overrides.json (slang + ambiguos)
# Vocabulario: en Docker lo genera el BUILD + entrypoint (no hace falta a mano).
#   venv local:  python -m smart_import.vocab setup
#                python -m smart_import.vocab setup --geonames
# SMART_IMPORT_VOCAB_PATH=data/vocab/smart_import_vocab.sqlite
# SMART_IMPORT_LOCALITY_EXPAND_PATH=...
# SMART_IMPORT_LOCALITY_GEONAMES_PATH=...
# SMART_IMPORT_VOCAB_GEONAMES=1              # 0 = skip cities15000 en docker build

# --------------------------------------------------------------- servicio
SMART_IMPORT_PORT=8100
SMART_IMPORT_HOST=0.0.0.0
# Interfaz donde se PUBLICA el puerto. El servicio no tiene auth propia, asi que
# en prod tiene que quedar en loopback y entrar solo por RouteHub.
# Local, si necesitas pegarle desde otra maquina: 0.0.0.0
SMART_IMPORT_BIND=127.0.0.1
# Horas que sobrevive un job terminado antes de que se borre su carpeta.
# 0 = no barrer (el disco crece sin techo; lo comparte con el cutter).
SMART_IMPORT_JOB_TTL_HOURS=24
# Origins del front (CSV). Local: * . Prod: el dominio real, NUNCA '*'.
# Si RouteHub llama server-side, CORS importa menos; si el browser pega a :8100, obligatorio.
# Ejemplo prod: https://app.vepathos.com,https://admin.vepathos.com
SMART_IMPORT_CORS_ORIGINS=*
SMART_IMPORT_VERBOSE=false

# --------------------------------------------------------------- limites
SMART_IMPORT_MAX_FILE_MB=10
SMART_IMPORT_MAX_ROWS=50000

# Cuantos archivos se normalizan A LA VEZ. El resto espera turno y, si no lo
# consigue en NORMALIZE_QUEUE_WAIT_S, recibe 429 + Retry-After.
# El normalize es Python CPU-bound, o sea que el GIL lo serializa: medido con
# 5k filas, 1 cliente tarda 1.3 s y 8 simultaneos tardan 10.5 s (8x, cero
# paralelismo) con la CPU en 1 core aunque el container tenga 4. Subir el cupo
# NO acelera nada; solo reparte la misma CPU entre mas gente. Sirve como techo:
# deja hilos libres para /health, el polling y las descargas.
SMART_IMPORT_MAX_CONCURRENT_NORMALIZE=4
SMART_IMPORT_NORMALIZE_QUEUE_WAIT_S=20

# Puerta de admision: cuantos imports pueden estar en el sistema a la vez,
# contando el que todavia esta subiendo. Se pide ANTES de leer el body, asi que
# el 429 no toca disco. Es el techo que acota una avalancha: el peor caso de
# disco ocupado por uploads en curso es este numero x MAX_FILE_MB (320 MB con
# los defaults). Sin esta puerta serian 10 GB con 1000 uploads simultaneos.
SMART_IMPORT_MAX_NORMALIZE_QUEUE=32

# Techo de tareas concurrentes de uvicorn. Por encima corta con 503 antes de
# que el request llegue a la app. OJO al bajarlo: los SSE de progreso son
# conexiones ABIERTAS y cuenta una por usuario mirando su import. 0 = sin techo.
SMART_IMPORT_HTTP_LIMIT_CONCURRENCY=512

# --------------------------------------------------------------- deteccion
AUTO_ACCEPT_THRESHOLD=0.90      # por encima: se acepta solo
REVIEW_THRESHOLD=0.70           # piso para reclamar una columna (nivel delivery)
SMART_IMPORT_SAMPLE_ROWS=20     # filas que se miran para decidir el mapping

# El piso baja segun el costo de equivocarse: un `address` mal mapeado manda el
# camion a otra direccion; un `weight_kg` mal mapeado es un numero mal en un
# reporte. Por defecto se derivan de REVIEW_THRESHOLD (-0.05 y -0.10); estas
# env fijan un nivel a mano y se pueden dejar vacias.
# MAPPING_MIN_DELIVERY=0.70
# MAPPING_MIN_TIMEWINDOW=0.65
# MAPPING_MIN_PACKAGE=0.60
SMART_IMPORT_DEFAULT_SCHEMA=vepathos_flat_v1

# --------------------------------------------------------------- geocoding
# GeoNames cities15000: centroide + pais por ciudad. Habilita "la ciudad manda
# sobre el pin del depot" y la deteccion de localidad del archivo (report.locality).
# Generalo con: python -m smart_import.vocab setup --geonames
# Sin esto el servicio funciona, pero sin centroides de ciudad.
SMART_IMPORT_GEONAMES_DIR=./data/geonames

# Raiz data/ del route-optimizer (extracts + paises). El compose la monta en /data/pbf:ro.
ROUTE_OPTIMIZER_DATA=/Users/martinvizzolini/workspace/route-optimizer-app/data
# Opcional: forzar un subdir. Si esta vacio, se usa ROUTE_OPTIMIZER_DATA.
# SMART_IMPORT_PBF_DIR=

GEOCODER_FALLBACK=none
# Cuantos geocodes simultaneos. OJO: NO acelera un import — el geocode de un
# archivo es secuencial. 2 significa "dos imports a la vez", no "la mitad de
# tiempo". Para acelerar uno, el camino es el indice (street, house_number).
SMART_IMPORT_GEOCODE_WORKERS=1
SMART_IMPORT_AUTOBUILD_INDEX=true
# Si no hay extract de ciudad, lo corta del PBF de pais (osmium-tool) en data/extracts.
# Nunca indexa argentina.sqlite / florida.sqlite enteros.
SMART_IMPORT_AUTOEXTRACT=true
# SMART_IMPORT_EXTRACT_DIR=data/extracts
# SMART_IMPORT_EXTRACT_MARGIN_KM=15
# SMART_IMPORT_EXTRACT_MAX_KM=80

# ---- umbrales y bandas: tienen que estar ALINEADOS ----
# Si no lo estan, el operador ve una cosa y el geocoder decidio otra. Tres reglas:
#
#   VALID_BAND == MATCH_THRESHOLD
#     `matched` sale con score >= max(MATCH_THRESHOLD, VALID_BAND), pero el
#     COLOR lo decide VALID_BAND solo. Con match=0.85 y valid=0.80, un 0,82
#     volvia con status=low_confidence y banda VERDE: un pin que dice "usalo
#     tal cual" sobre algo que el geocoder marco dudoso.
#
#   REVIEW_BAND == LOW_CONFIDENCE_THRESHOLD
#     LOW_CONFIDENCE es el piso para DEVOLVER coordenada; REVIEW_BAND el piso
#     para MOSTRARLA. Si REVIEW fuera mas alto, se calculan pines que se tiran.
#
#   SOFT_REJECT_MIN >= REVIEW_BAND
#     El soft-reject da un pin de respaldo para medir distancia en el mapa. Por
#     debajo de REVIEW_BAND la banda lo pasa a needs_geocoding y le saca el pin.
#
# Resultado: >=0.85 verde/matched | 0.70-0.85 ambar/low_confidence | <0.70 sin pin.
# Las bandas aceptan 0.85 o 85.
GEOCODE_MATCH_THRESHOLD=0.85
GEOCODE_VALID_BAND=0.85
GEOCODE_LOW_CONFIDENCE_THRESHOLD=0.70
GEOCODE_REVIEW_BAND=0.70
GEOCODE_SOFT_REJECT=true
GEOCODE_SOFT_REJECT_MIN=0.75

# Cuan fuerte tiene que matchear la CALLE para aceptar cualquier coordenada.
# Guardian del falso positivo mas caro del indice: coincidir solo en la altura
# hace que 'Av. Pueyrredon 359' resuelva a 'Venezuela 359', a kilometros.
# NO bajarlo sin correr tests/test_geocode_accuracy.py.
GEOCODE_STREET_MATCH_MIN=0.70
# Piso para dar pin a nivel calle (sin altura). Siempre sale ambar.
GEOCODE_STREET_LEVEL_FLOOR=0.60
# Geofences: atrapan el pin que matcheo bien el texto en la ciudad equivocada
# (una calle homonima en otra provincia es un match textual perfecto).
GEOCODE_MAX_LOW_CONFIDENCE_KM=15
GEOCODE_MAX_DISTANCE_KM=500

# --------------------------------------------------------------- recursos (docker compose)
# mem_limit / cpus del servicio. Tras cambiar:
#   unset SMART_IMPORT_CPUS SMART_IMPORT_MEMORY_LIMIT   # el shell pisa .env
#   docker compose up -d --force-recreate smart-import
# Local con geocoding: 4–8g / 2–4. Variables exportadas en el shell ganan sobre .env.
SMART_IMPORT_MEMORY_LIMIT=8g
SMART_IMPORT_CPUS=4
IMAGE_TAG=latest
