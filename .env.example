# ===========================================================================
# Smart Import — configuracion unica para local y produccion.
#
#   cp .env.example .env      y edita lo que necesites
#
# Por defecto arranca TODO: normalize + geocoding + modelo de IA.
# Cada capacidad se apaga con su flag sin tocar nada mas.
# ===========================================================================

# --------------------------------------------------------------- que corre
# El nucleo (normalize) SIEMPRE esta. Estas dos son opcionales:
SMART_IMPORT_GEOCODING_ENABLED=true
SMART_IMPORT_AI_ENABLED=true

# Imagen a construir: `ai` incluye torch (~3 GB), `runtime` no (~400 MB).
# Si SMART_IMPORT_AI_ENABLED=false, usa runtime y la imagen baja 8x.
SMART_IMPORT_TARGET=ai

# --------------------------------------------------------------- servicio
SMART_IMPORT_PORT=8100
SMART_IMPORT_HOST=0.0.0.0
# Dominios permitidos por CORS. En produccion pone el de tu web, NO '*'.
SMART_IMPORT_CORS_ORIGINS=*
SMART_IMPORT_VERBOSE=false

# --------------------------------------------------------------- limites
SMART_IMPORT_MAX_FILE_MB=10
SMART_IMPORT_MAX_ROWS=50000

# --------------------------------------------------------------- deteccion
AUTO_ACCEPT_THRESHOLD=0.90      # por encima: se acepta solo
REVIEW_THRESHOLD=0.70           # por debajo: no se mapea
SMART_IMPORT_SAMPLE_ROWS=20     # filas que se miran para decidir el mapping
SMART_IMPORT_DEFAULT_SCHEMA=vepathos_flat_v1

# --------------------------------------------------------------- IA
# Precargar al arrancar evita que el primer usuario pague los ~60 s de descarga.
SMART_IMPORT_AI_PRELOAD=true
SMART_IMPORT_MODEL=numind/NuExtract-1.5-tiny
SMART_IMPORT_DEVICE=cpu         # cpu | mps (Apple Silicon) | cuda | auto
SMART_IMPORT_EXTRACT_MAX_ROWS=2000    # ~1.4 s por fila: tope obligatorio
SMART_IMPORT_EXTRACT_WORKERS=1

# --------------------------------------------------------------- geocoding
# En el HOST: donde estan los .osm.pbf que ya genera el cutter.
# El compose lo monta read-only en /data/pbf dentro del container.
ROUTE_OPTIMIZER_DATA=/home/martin/route-optimizer-app/data

GEOCODER_FALLBACK=none          # 'none' = nunca llama a un servicio externo
GEOCODE_MATCH_THRESHOLD=0.90
GEOCODE_LOW_CONFIDENCE_THRESHOLD=0.70
SMART_IMPORT_GEOCODE_WORKERS=1
SMART_IMPORT_AUTOBUILD_INDEX=true     # construir el indice de una region si falta

# --------------------------------------------------------------- recursos
SMART_IMPORT_MEMORY_LIMIT=4g
SMART_IMPORT_CPUS=2
IMAGE_TAG=latest
