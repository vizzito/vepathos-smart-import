# ===========================================================================
# Smart Import — configuracion unica para local y produccion.
#
#   cp .env.example .env      y edita lo que necesites
#
# El pipeline es determinístico: reglas + librerias, sin modelo.
# Cada capacidad opcional se apaga con su flag sin tocar nada mas.
# ===========================================================================

# --------------------------------------------------------------- que corre
# El nucleo (normalize + extraccion determinística) SIEMPRE esta. Estas son opcionales:
SMART_IMPORT_GEOCODING_ENABLED=true

# Imagen Docker (build target, no un modo de runtime):
#   runtime              ~370 MB  — sin libpostal
#   runtime-libpostal    +~2 GB   — enhancer on-demand (recomendado en prod)
SMART_IMPORT_TARGET=runtime-libpostal

# --------------------------------------------- extraccion (reglas, sin modelo)
# Region ISO por defecto para telefonos (AR, BR, US, IN...). El job puede pisarla.
SMART_IMPORT_DEFAULT_PHONE_REGION=AR
# Un segmento de texto libre es una entrega a partir de este score de evidencia.
SMART_IMPORT_DELIVERY_ACCEPT_THRESHOLD=0.55
SMART_IMPORT_DELIVERY_REVIEW_THRESHOLD=0.30
# Por debajo de esto una direccion no se acepta NI se manda al geocoder.
SMART_IMPORT_ADDRESS_ACCEPT_THRESHOLD=0.50
# Cuanta evidencia estructural necesita un .txt para tratarse como tabla.
SMART_IMPORT_TEXT_MIN_CONSISTENCY=0.80
SMART_IMPORT_TEXT_MAX_PROSE_RATIO=0.20

# --------------------------------------------------- parser de direcciones
# El heuristico SIEMPRE corre. libpostal es enhancer on-demand: solo se consulta
# cuando el gate detecta road faltante o sospechosa (parcela, manzana, India…).
# Requiere imagen `runtime-libpostal`. Ver docs/libpostal.md.
SMART_IMPORT_LIBPOSTAL_ENABLED=true
# Solo para benchmarks (`benchmark-extraction`): heuristic | libpostal | enhanced
# SMART_IMPORT_ADDRESS_PARSER=heuristic
#
# Lexicons (JSON en smart_import/resources/). Override opcional:
# SMART_IMPORT_RESOURCES_DIR=/path/to/dir   # reemplaza todos los *.json por nombre
# SMART_IMPORT_LABELS_PATH=...
# SMART_IMPORT_GEO_KEYWORDS_PATH=...
# SMART_IMPORT_OVERRIDES_PATH=...            # vepathos_overrides.json (slang + ambiguos)
# Vocabulario: en Docker lo genera el BUILD + entrypoint (no hace falta a mano).
#   venv local:  python -m smart_import.vocab setup
#                python -m smart_import.vocab setup --geonames
# SMART_IMPORT_VOCAB_PATH=data/vocab/smart_import_vocab.sqlite
# SMART_IMPORT_LOCALITY_EXPAND_PATH=...
# SMART_IMPORT_LOCALITY_GEONAMES_PATH=...
# SMART_IMPORT_VOCAB_GEONAMES=1              # 0 = skip cities15000 en docker build

# --------------------------------------------------------------- servicio
SMART_IMPORT_PORT=8100
SMART_IMPORT_HOST=0.0.0.0
# Origins del front (CSV). Local: * . Prod: el dominio real, NUNCA '*'.
# Si RouteHub llama server-side, CORS importa menos; si el browser pega a :8100, obligatorio.
# Ejemplo prod: https://app.vepathos.com,https://admin.vepathos.com
SMART_IMPORT_CORS_ORIGINS=*
SMART_IMPORT_VERBOSE=false

# --------------------------------------------------------------- limites
SMART_IMPORT_MAX_FILE_MB=10
SMART_IMPORT_MAX_ROWS=50000

# --------------------------------------------------------------- deteccion
AUTO_ACCEPT_THRESHOLD=0.90      # por encima: se acepta solo
REVIEW_THRESHOLD=0.70           # por debajo: no se mapea
SMART_IMPORT_SAMPLE_ROWS=20     # filas que se miran para decidir el mapping
SMART_IMPORT_DEFAULT_SCHEMA=vepathos_flat_v1

# --------------------------------------------------------------- geocoding
# Raiz data/ del route-optimizer (extracts + paises). El compose la monta en /data/pbf:ro.
ROUTE_OPTIMIZER_DATA=/Users/martinvizzolini/workspace/route-optimizer-app/data
# Opcional: forzar un subdir. Si esta vacio, se usa ROUTE_OPTIMIZER_DATA.
# SMART_IMPORT_PBF_DIR=

GEOCODER_FALLBACK=none
SMART_IMPORT_GEOCODE_WORKERS=2
SMART_IMPORT_AUTOBUILD_INDEX=true
# Si no hay extract de ciudad, lo corta del PBF de pais (osmium-tool) en data/extracts.
# Nunca indexa argentina.sqlite / florida.sqlite enteros.
SMART_IMPORT_AUTOEXTRACT=true
# SMART_IMPORT_EXTRACT_DIR=data/extracts
# SMART_IMPORT_EXTRACT_MARGIN_KM=15
# SMART_IMPORT_EXTRACT_MAX_KM=80

# ---- 1) ESCRITURA de coords (cuantos pines) ----
# Regla tipica UI (capa B): >=0.85 verde, 0.75–0.85 ambar, <0.75 sin pin
# SOFT_REJECT_MIN debe ser >= REVIEW_BAND o el stamp saca el pin igual.
GEOCODE_LOW_CONFIDENCE_THRESHOLD=0.70
GEOCODE_MATCH_THRESHOLD=0.85
GEOCODE_STREET_MATCH_MIN=0.70
GEOCODE_STREET_LEVEL_FLOOR=0.60
GEOCODE_SOFT_REJECT=true
GEOCODE_SOFT_REJECT_MIN=0.75
GEOCODE_MAX_LOW_CONFIDENCE_KM=15
GEOCODE_MAX_DISTANCE_KM=500

# ---- 2) COLOR UI (geocode_band). Acepta 0.70 o 70.
GEOCODE_REVIEW_BAND=0.75
GEOCODE_VALID_BAND=0.85

# --------------------------------------------------------------- recursos (docker compose)
# mem_limit / cpus del servicio. Tras cambiar:
#   unset SMART_IMPORT_CPUS SMART_IMPORT_MEMORY_LIMIT   # el shell pisa .env
#   docker compose up -d --force-recreate smart-import
# Local con geocoding: 4–8g / 2–4. Variables exportadas en el shell ganan sobre .env.
SMART_IMPORT_MEMORY_LIMIT=8g
SMART_IMPORT_CPUS=4
IMAGE_TAG=latest

# --------------------------------------------------------------- cola + object storage (local prod-shaped)
# `docker compose --profile infra up -d`  → RabbitMQ + MinIO
# Sin esto, normalize/geocode siguen en proceso (ThreadPool) como hasta ahora.
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
SMART_IMPORT_QUEUE=smart-import-tasks

USE_S3=false
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=vepathosprod
S3_REGION=us-east-1
