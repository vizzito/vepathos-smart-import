# ---- limites de entrada ----
SMART_IMPORT_MAX_FILE_MB=10
SMART_IMPORT_MAX_ROWS=50000

# ---- deteccion de schema ----
AUTO_ACCEPT_THRESHOLD=0.90
REVIEW_THRESHOLD=0.70
SMART_IMPORT_SAMPLE_ROWS=20

# ---- IA (opcional; el sistema funciona entero sin esto) ----
SMART_IMPORT_AI_ENABLED=false
SMART_IMPORT_MODEL=numind/NuExtract-1.5-tiny
SMART_IMPORT_DEVICE=cpu          # cpu | mps (Apple Silicon) | cuda | auto
SMART_IMPORT_AI_TIMEOUT=30

# ---- geocoding ----
# Los _extracts del cutter, montados read-only
SMART_IMPORT_PBF_DIR=/data/pbf
SMART_IMPORT_INDEX_DIR=/data/indexes
SMART_IMPORT_CACHE_PATH=/data/cache/geocode_cache.sqlite
GEOCODER_FALLBACK=none           # 'none' = nunca llama a un servicio externo
GEOCODE_MATCH_THRESHOLD=0.90
GEOCODE_LOW_CONFIDENCE_THRESHOLD=0.70
SMART_IMPORT_EXTRACT_MAX_ROWS=2000
