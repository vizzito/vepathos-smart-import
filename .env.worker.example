# ===========================================================================
# Smart Import — nodo WORKER
#
#   cp .env.worker.example .env.worker
#   docker compose --env-file .env.worker -f docker-compose.worker.yml \
#     run --rm worker worker --check
#   docker compose --env-file .env.worker -f docker-compose.worker.yml up -d
#
# Un worker no sirve HTTP, no guarda jobs y no tiene estado propio: se puede
# matar o duplicar sin coordinar nada. Todo lo que necesita es poder llegar a
# tres lugares — la cola, Redis y la api — y esas tres cosas se configuran aca.
#
# El rol NO esta en este archivo: lo fija docker-compose.worker.yml. Asi copiar
# el .env de otro nodo no puede convertir a este proceso en otra cosa.
# ===========================================================================


# ===========================================================================
# A donde se conecta
# ===========================================================================
# La cola de tareas. Mismo broker que usa el optimizer; lo que separa los dos
# servicios es el prefijo de las colas, no la instancia.
RABBITMQ_HOST=10.0.0.2
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
SMART_IMPORT_QUEUE_PREFIX=smart-import

# El estado de los jobs. DB 1 para no compartir espacio de claves con el
# optimizer, que corre todo en la 0.
REDIS_HOST=10.0.0.2
REDIS_PORT=6379
REDIS_PASSWORD=
SMART_IMPORT_REDIS_DB=1
SMART_IMPORT_REDIS_PREFIX=smartimport:

# De donde bajar los archivos de cada job y a donde devolver los resultados.
# Es el nodo api, y esta conexion la abre SIEMPRE el worker: por eso una Mac
# detras de NAT puede ser un nodo sin abrir un solo puerto.
SMART_IMPORT_API_URL=http://10.0.0.4:8100

# La credencial del canal api<->worker. Tiene que ser EXACTAMENTE la misma que
# tiene el nodo api; si no, sus rutas /internal responden 404 y este worker no
# puede bajar ni un archivo.
#   openssl rand -hex 32
SMART_IMPORT_WORKER_TOKEN=

# El token viaja en texto plano: este enlace va por red privada o por el tunel
# SSH. No lo publiques en internet.


# ===========================================================================
# Que hace este nodo
# ===========================================================================
# De que colas come. El geocode SOLO donde hay PBF montado: un nodo suscripto
# sin mapas se lleva tareas que solo puede fallar, y rebotan hasta la DLQ
# mientras el que si puede hacerlas mira sin trabajo. El proceso ni arranca si
# se contradice con ROUTE_OPTIMIZER_DATA.
SMART_IMPORT_CONSUME_NORMALIZE=true
SMART_IMPORT_CONSUME_GEOCODE=false

# Tareas en paralelo. De aca sale el prefetch (nunca mas alto que los slots: un
# mensaje entregado sin thread libre corre contra el timeout del broker sin que
# nadie lo este trabajando). El normalize es CPU-bound y el GIL lo serializa,
# asi que 2-4 por nodo; para mas capacidad, mas nodos.
SMART_IMPORT_WORKER_SLOTS=2

# Cuanto puede tardar una tarea antes de darla por colgada. Pasado esto se
# aparta a la DLQ y el job queda fallido: el usuario ve un error en vez de un
# spinner eterno. El de geocode es generoso porque puede incluir construir el
# indice OSM de una region.
SMART_IMPORT_TASK_TIMEOUT_NORMALIZE_S=300
SMART_IMPORT_TASK_TIMEOUT_GEOCODE_S=1800

# Intentos antes de apartar una tarea. Solo cuentan las fallas que pueden andar
# mejor la proxima; un archivo corrupto no se reintenta nunca.
SMART_IMPORT_MAX_REQUEUE_ATTEMPTS=10

# Cuanto se espera antes de dar por muerto a un nodo que dejo de dar senales.
# NO es cuanto puede durar una tarea: mientras el worker vive renueva el lock
# cada un tercio de esto, asi que un geocode de una hora lo sostiene sin
# problema. Es lo que tarda OTRO nodo en retomar el trabajo del que se cayo,
# mas un tercio mas de espera hasta que vuelve a preguntar (con 30 -> hasta 40s).
#
# Bajarlo acelera el failover y sube el riesgo de una muerte falsa: si una pausa
# de GC, un hipo de Redis o una laptop que se suspende dejan al worker sin
# renovar por mas de este tiempo, otro toma el job y el mismo archivo se procesa
# dos veces (no se rompe nada: gana el que termina ultimo, pero es trabajo
# tirado). El piso es 10 s y el arranque avisa si pusiste menos.
#   red local y nodos estables -> 15
#   workers en casas ajenas o laptops -> 45-60
SMART_IMPORT_RUN_LOCK_TTL_S=30

# Cuanto espera al bajar a lo que tiene en vuelo. Que sea MENOR al
# stop_grace_period del compose, o Docker lo mata en el medio del drenaje.
SMART_IMPORT_SHUTDOWN_DRAIN_S=60


# ===========================================================================
# Imagen y recursos
# ===========================================================================
# `runtime` (~370 MB) alcanza para normalizar. `runtime-libpostal` (+~2 GB)
# solo si este nodo hace direcciones fuera de LatAm.
SMART_IMPORT_TARGET=runtime
IMAGE_TAG=latest

# Nombre del container: dos workers en la misma maquina necesitan nombres
# distintos.
SMART_IMPORT_WORKER_NAME=vepathos-smart-import-worker

# Raiz data/ del route-optimizer, con los .osm.pbf. Solo importa si este nodo
# consume geocode; con CONSUME_GEOCODE=false podes dejarlo como esta.
ROUTE_OPTIMIZER_DATA=./data

SMART_IMPORT_MEMORY_LIMIT=8g
SMART_IMPORT_CPUS=4
# Tiene que ser MAYOR que SHUTDOWN_DRAIN_S: es el margen que Docker le da al
# proceso para terminar lo que estaba haciendo antes del SIGKILL.
SMART_IMPORT_STOP_GRACE=90s

# false en prod: `verbose` loguea direcciones y nombres de clientes finales.
SMART_IMPORT_VERBOSE=false
