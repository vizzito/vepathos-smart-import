# Smart Import — api-prod (178.105.42.199) — nodo API
# cp deploy/templates/api-prod.env.template .env
# docker compose -f docker-compose.yml -f docker-compose.apiprod.yml up -d smart-import

SMART_IMPORT_ENV_FILE=.env
SMART_IMPORT_TARGET=runtime
IMAGE_TAG=2026.09.07

SMART_IMPORT_GEONAMES_DIR=./data/geonames

# Publicación: loopback + privada + pública (overlay apiprod). NUNCA 0.0.0.0 solo.
SMART_IMPORT_BIND=127.0.0.1
SMART_IMPORT_BIND_PRIV=10.0.0.2
SMART_IMPORT_BIND_PUB=178.105.42.199
SMART_IMPORT_PORT=8100

SMART_IMPORT_MEMORY_LIMIT=2g
SMART_IMPORT_CPUS=2
SMART_IMPORT_START_PERIOD=90s

SMART_IMPORT_HOST=0.0.0.0
SMART_IMPORT_CORS_ORIGINS=https://vepathos.com
SMART_IMPORT_JOB_TTL_HOURS=24
SMART_IMPORT_VERBOSE=false

SMART_IMPORT_MAX_FILE_MB=10
SMART_IMPORT_MAX_ROWS=50000
SMART_IMPORT_HTTP_LIMIT_CONCURRENCY=512
SMART_IMPORT_MAX_NORMALIZE_QUEUE=32
SMART_IMPORT_MAX_CONCURRENT_NORMALIZE=4
SMART_IMPORT_NORMALIZE_QUEUE_WAIT_S=20

SMART_IMPORT_GEOCODING_ENABLED=true
SMART_IMPORT_LIBPOSTAL_ENABLED=false

SMART_IMPORT_DEFAULT_PHONE_REGION=AR
SMART_IMPORT_DEFAULT_SCHEMA=vepathos_flat_v1

# Umbrales de geocode — TIENEN que coincidir con los workers (fleet.config_drift)
GEOCODE_MATCH_THRESHOLD=0.85
GEOCODE_VALID_BAND=0.85
GEOCODE_LOW_CONFIDENCE_THRESHOLD=0.70
GEOCODE_REVIEW_BAND=0.70
GEOCODE_SOFT_REJECT=true
GEOCODE_SOFT_REJECT_MIN=0.75
GEOCODE_STREET_MATCH_MIN=0.70
GEOCODE_STREET_LEVEL_FLOOR=0.60
GEOCODE_MAX_DISTANCE_KM=500
GEOCODE_MAX_LOW_CONFIDENCE_KM=15

SMART_IMPORT_ROLE=api
SMART_IMPORT_QUEUE_PREFIX=smart-import
SMART_IMPORT_REDIS_DB=1
SMART_IMPORT_REDIS_PREFIX=smartimport:
SMART_IMPORT_WORKER_TOKEN=GENERAR_CON_openssl_rand_hex_32
SMART_IMPORT_DEFAULT_WAIT_S=30

# Por nombre de container (overlay apiprod → red optimizer)
REDIS_HOST=route-optimizer-redis
REDIS_PORT=6379
REDIS_PASSWORD=COPIAR_DEL_OPTIMIZER
RABBITMQ_HOST=route-optimizer-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=vepathos
RABBITMQ_PASSWORD=COPIAR_DEL_OPTIMIZER
RABBITMQ_VHOST=/
