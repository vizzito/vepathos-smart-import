# Smart Import — Mac — worker prod con libpostal (túnel SSH)
# cp deploy/templates/worker-mac.env.template .env.prod.smart.local
#
# 1) ~/.ssh/config → Host vepathos-tunnel (16379, 5673, 8110) — ver DEPLOY-PRODUCTION.md §6.2
# 2) autossh -M 0 -o ServerAliveInterval=30 -o ExitOnForwardFailure=yes -N vepathos-tunnel &
# 3) docker compose --env-file .env.prod.smart.local \
#      -f docker-compose.worker.yml -f docker-compose.mac.worker.yml up -d

SMART_IMPORT_BASE_ENV=.env.prod.smart.local
SMART_IMPORT_ENV_FILE=.env.prod.smart.local

SMART_IMPORT_TARGET=runtime-libpostal
IMAGE_TAG=latest
SMART_IMPORT_LIBPOSTAL_ENABLED=true
SMART_IMPORT_WORKER_NAME=si-worker-prod-mac
SMART_IMPORT_WORKER_SLOTS=2
SMART_IMPORT_RUN_LOCK_TTL_S=45

SMART_IMPORT_WORKER_TOKEN=MISMO_QUE_API_PROD

# El overlay mac.worker.yml pisa hosts/puertos; API_URL documentada:
SMART_IMPORT_API_URL=http://host.docker.internal:8110

SMART_IMPORT_CONSUME_NORMALIZE=true
SMART_IMPORT_CONSUME_GEOCODE=true
SMART_IMPORT_VERBOSE=false

ROUTE_OPTIMIZER_DATA=/Users/TU_USUARIO/workspace/route-optimizer-app/data

# Alias OSM: el compose ya apunta a /data/cache/street_aliases.sqlite
# Copiar el sqlite del host: ver DEPLOY-PRODUCTION.md §13.0a

# Umbrales — copiar del .env de api-prod (mismos GEOCODE_* que api y VM)
# OJO: libpostal_enabled=true → config_drift permanente en /health (esperado)
