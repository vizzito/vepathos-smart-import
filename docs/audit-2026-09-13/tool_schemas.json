                "maximum": 1,
                "minimum": 0,
                "title": "Confidence",
                "type": "number"
              },
              "requires_review": {
                "title": "Requires Review",
                "type": "boolean"
              }
            },
            "required": [
              "original_address",
              "normalized_address",
              "status",
              "precision",
              "confidence",
              "requires_review"
            ],
            "title": "AddressResult",
            "type": "object"
          },
          "Failure": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "INVALID_ARGUMENT",
                  "BUSY",
                  "TIMEOUT",
                  "NOT_FOUND",
                  "CONFLICT",
                  "INTERNAL"
                ],
                "title": "Code",
                "type": "string"
              },
              "message": {
                "title": "Message",
                "type": "string"
              },
              "retryable": {
                "title": "Retryable",
                "type": "boolean"
              },
              "retry_after_ms": {
                "anyOf": [
                  {
                    "maximum": 300000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Retry After Ms"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "title": "Failure",
            "type": "object"
          },
          "Point": {
            "additionalProperties": false,
            "properties": {
              "lat": {
                "description": "WGS84 latitude, degrees",
                "maximum": 90,
                "minimum": -90,
                "title": "Lat",
                "type": "number"
              },
              "lon": {
                "description": "WGS84 longitude, degrees",
                "maximum": 180,
                "minimum": -180,
                "title": "Lon",
                "type": "number"
              }
            },
            "required": [
              "lat",
              "lon"
            ],
            "title": "Point",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "state": {
            "enum": [
              "accepted",
