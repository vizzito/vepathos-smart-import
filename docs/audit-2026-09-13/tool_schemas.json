              }
            ],
            "default": null,
            "title": "Job Id"
          },
          "poll_after_ms": {
            "anyOf": [
              {
                "maximum": 30000,
                "minimum": 100,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Poll After Ms"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/$defs/AddressResult"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/$defs/Failure"
